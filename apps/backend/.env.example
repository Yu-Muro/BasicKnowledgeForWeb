# Database Configuration
DATABASE_URL=postgresql://root@localhost:26257/basic-knowledge-for-web?sslmode=disable

# Application Configuration
NODE_ENV=local
PORT=8080
JWT_SECRET=dev-secret-please-change-in-local
# 32文字以上のランダムな値を設定（ローカルWorkerでは .dev.vars にも設定）
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080
SHOP_ITEM_ASSET_BASE_URL=http://localhost:8080/assets

# Cloudflare Workers Configuration (if needed)
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
